# Discord Webhook Configuration
# Copy this file to server/.env and replace with your actual Discord webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Example webhook URL format:
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789012345678/abcdefghijklmnopqrstuvwxyz-AbCdEfGhIjKlMnOpQrStUvWxYz123456

# Instructions:
# 1. Copy this file to GameServerManager/server/.env
# 2. Replace YOUR_WEBHOOK_ID and YOUR_WEBHOOK_TOKEN with your actual values from Discord
# 3. Save the file
# 4. Restart your server

# Server Configuration (Optional)
# PORT=54321
# NODE_ENV=production

# RCON Configuration (Optional - these are defaults)
# ARK_RCON_PASSWORD=420
# ARK_RCON_PORT=32330 